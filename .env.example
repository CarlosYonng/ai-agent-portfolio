# 复制为 .env 后用于本地 debug，复制为 .env.docker 后用于 Docker Compose。
AI_SERVICE_BASE_URL=http://localhost:8000
MCP_BASE_URL=http://localhost:8100
LLM_PROVIDER=mock
LLM_TOKEN=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# text-embedding-v4 是模型名，不是独立 key；优先填写真实 embedding 服务 token。
EMBEDDING_TOKEN=
# 兼容旧脚本和 DashScope 命名，未填写 EMBEDDING_TOKEN 时会回退读取这里。
DASHSCOPE_TOKEN=

# 本地 debug 默认通过 localhost 访问 Docker 暴露出的基础设施端口。
MYSQL_DSN=mysql://agent:agent123@localhost:3306/agentdb
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=agent123456
REDIS_URL=redis://localhost:6379/0
