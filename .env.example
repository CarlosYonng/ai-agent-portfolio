# 复制为 .env 后用于本地 debug，复制为 .env.docker 后用于 Docker Compose。
# 注意：.env 不支持变量展开，改端口时需同步修改 AI_SERVICE_BASE_URL 中的端口。
AI_SERVICE_BASE_URL=http://localhost:8000
# 本地启动端口配置，修改此处即可避免与本地其他服务冲突。
AI_SERVICE_PORT=8000
JAVA_PORT=8080
LLM_PROVIDER=openai-compatible
LLM_TOKEN=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# text-embedding-v4 是模型名；优先填写真实 embedding 服务 token，未配置时入库会明确失败。
EMBEDDING_TOKEN=
# 兼容旧脚本和 DashScope 命名，未填写 EMBEDDING_TOKEN 时会回退读取这里。
DASHSCOPE_TOKEN=

# 本地 debug 默认通过 localhost 访问 Docker 暴露出的基础设施端口。
MYSQL_DSN=mysql://agent:agent123@localhost:3306/agentdb
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/agentdb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&connectTimeout=3000&socketTimeout=15000
SPRING_DATASOURCE_USERNAME=agent
SPRING_DATASOURCE_PASSWORD=agent123
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=agent123456
REDIS_URL=redis://localhost:6379/0
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=

# Incident Copilot 告警入口；本地 Java/AI 进程可用 localhost，Docker 容器通常用 host.docker.internal。
INCIDENT_COPILOT_BASE_URL=http://localhost:8080/api
INCIDENT_COPILOT_GRAFANA_WEBHOOK_URL=http://localhost:8080/api/alerts/grafana

# Prometheus/Grafana 本地演示配置。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# 本地故障注入默认关闭；只用于验证告警链路，不影响真实接口。
PORTFOLIO_DEMO_FAULTS_ENABLED=false
PORTFOLIO_DEMO_AI_SLEEP_MS=65000
