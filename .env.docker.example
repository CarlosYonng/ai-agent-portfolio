# Docker Compose 运行配置示例。复制为 .env.docker 后按需填写真实 token。
# 注意：.env 不支持变量展开，改端口时需同步修改 AI_SERVICE_BASE_URL 中的端口。
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000
JAVA_PORT=8080
LLM_PROVIDER=mock
LLM_TOKEN=
LLM_BASE_URL=
LLM_MODEL=mock
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_TOKEN=
DASHSCOPE_TOKEN=

MYSQL_DSN=mysql://agent:agent123@mysql:3306/agentdb
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=agent123456
REDIS_URL=redis://redis:6379/0

INCIDENT_COPILOT_BASE_URL=http://host.docker.internal:8080/api
INCIDENT_COPILOT_GRAFANA_WEBHOOK_URL=http://host.docker.internal:8080/api/alerts/grafana

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

PORTFOLIO_DEMO_FAULTS_ENABLED=false
PORTFOLIO_DEMO_AI_SLEEP_MS=65000
