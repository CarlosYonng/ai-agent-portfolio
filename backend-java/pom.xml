<!-- Java 后端 Maven 父工程：统一版本、模块顺序和构建入口。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.yonng</groupId>
    <artifactId>agent-backend-java-parent</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>
    <name>agent-backend-java-parent</name>

    <modules>
        <module>agent-domain</module>
        <module>agent-infrastructure</module>
        <module>agent-application</module>
        <module>agent-api</module>
        <module>agent-boot</module>
    </modules>

    <properties>
        <!-- Java 21 是当前 LTS，本项目启用 record、Stream.toList 和虚拟线程等现代特性。 -->
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块版本只跟随父工程，子模块不再散落声明版本号。 -->
            <dependency>
                <groupId>com.yonng</groupId>
                <artifactId>agent-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yonng</groupId>
                <artifactId>agent-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yonng</groupId>
                <artifactId>agent-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yonng</groupId>
                <artifactId>agent-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis Plus 版本集中管理，避免不同模块声明不一致。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
