<!-- 启动层：装配 Spring Boot、属性注入、运行时驱动和最终可执行 Jar。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yonng</groupId>
        <artifactId>agent-backend-java-parent</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>agent-boot</artifactId>
    <name>agent-boot</name>

    <dependencies>
        <dependency>
            <groupId>com.yonng</groupId>
            <artifactId>agent-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yonng</groupId>
            <artifactId>agent-infrastructure</artifactId>
        </dependency>

        <!-- 启动层统一提供 Web MVC、内嵌 Tomcat、Jackson 等运行时能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation 的运行时实现放在启动层，API/业务层只依赖 validation-api。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator 提供 /actuator/health，service.sh 使用它做 Java 服务状态检查。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Prometheus registry 让 Actuator 暴露 /actuator/prometheus，供 Prometheus 抓取真实业务指标。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- MyBatis Plus Spring Boot 自动配置集中在启动层，Mapper 接口仍放在基础设施层。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动仅运行期需要，编译期由 Mapper/实体层完成。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis：缓存、限流、JWT 黑名单 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Redisson：分布式锁 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>3.38.1</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- application.yml 中的 @project.version@ 由 Maven 过滤成当前发布版本。 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- 只有启动层需要打成可执行 Spring Boot Jar。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
