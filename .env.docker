# Docker Compose 运行配置。容器之间通过 compose service name 访问。
AI_SERVICE_BASE_URL=http://ai-service:8000
MCP_BASE_URL=http://mcp-server:8100
LLM_PROVIDER=mock
LLM_TOKEN=
LLM_BASE_URL=
LLM_MODEL=mock
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash
EMBEDDING_DIMENSIONS=128
EMBEDDING_BASE_URL=
# Docker 默认走 hash embedding，不需要外部 token；切真实模型时优先填写 EMBEDDING_TOKEN。
EMBEDDING_TOKEN=
# 兼容旧脚本和 DashScope 命名，未填写 EMBEDDING_TOKEN 时会回退读取这里。
DASHSCOPE_TOKEN=

MYSQL_DSN=mysql://agent:agent123@mysql:3306/agentdb
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=agent123456
REDIS_URL=redis://redis:6379/0
