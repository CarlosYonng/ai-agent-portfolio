# Docker Compose 运行配置。容器之间通过 compose service name 访问。
# 注意：.env 不支持变量展开，改端口时需同步修改 AI_SERVICE_BASE_URL 中的端口。
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000
JAVA_PORT=8080
LLM_PROVIDER=mock
LLM_TOKEN=
LLM_BASE_URL=
LLM_MODEL=mock
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 生产/演示链路使用真实 embedding；未配置 EMBEDDING_TOKEN 时入库会明确失败。
EMBEDDING_TOKEN=
# 兼容旧脚本和 DashScope 命名，未填写 EMBEDDING_TOKEN 时会回退读取这里。
DASHSCOPE_TOKEN=

MYSQL_DSN=mysql://agent:agent123@mysql:3306/agentdb
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=agent123456
REDIS_URL=redis://redis:6379/0

# Docker 中推送宿主机上的 ai-incident-copilot。
INCIDENT_COPILOT_BASE_URL=http://host.docker.internal:8080/api
INCIDENT_COPILOT_GRAFANA_WEBHOOK_URL=http://host.docker.internal:8080/api/alerts/grafana

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# 本地演示故障注入默认关闭。
PORTFOLIO_DEMO_FAULTS_ENABLED=false
PORTFOLIO_DEMO_AI_SLEEP_MS=65000
